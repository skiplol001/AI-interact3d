@model List<Interact3D.DTOs.Model.ModelDto>
@{
    ViewData["Title"] = "Quản Lý Models 3D";
}

<div style="max-width: 1100px; margin: 40px auto; padding: 0 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <h2 style="color: #38bdf8;">Kho Tài Nguyên Model 3D</h2>
        <div>
            <a href="/Home/Index" style="margin-right: 12px; color: #94a3b8; text-decoration: none;">← Về Scene 3D</a>
            <a href="/Admin/Upload" style="background: #0284c7; color: white; padding: 8px 16px; border-radius: 6px; text-decoration: none; font-weight: 600;">+ Tải Lên Model</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: rgba(74, 222, 128, 0.2); border: 1px solid #4ade80; color: #4ade80; padding: 12px; border-radius: 6px; margin-bottom: 16px;">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div style="background: rgba(248, 113, 113, 0.2); border: 1px solid #f87171; color: #f87171; padding: 12px; border-radius: 6px; margin-bottom: 16px;">
            @TempData["ErrorMessage"]
        </div>
    }

    <div style="background: #1e293b; border-radius: 8px; border: 1px solid #334155; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead>
                <tr style="background: #0f172a; color: #94a3b8; border-bottom: 1px solid #334155;">
                    <th style="padding: 14px;">Tên Model</th>
                    <th style="padding: 14px;">Định Dạng</th>
                    <th style="padding: 14px;">Chuẩn Khung Xương</th>
                    <th style="padding: 14px;">Loại</th>
                    <th style="padding: 14px; text-align: right;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="border-bottom: 1px solid #334155;">
                        <td style="padding: 14px; font-weight: 600; color: #f8fafc;">
                            @item.Name
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <div style="font-size: 0.8rem; color: #64748b; font-weight: normal;">@item.Description</div>
                            }
                        </td>
                        <td style="padding: 14px; color: #cbd5e1;">@System.IO.Path.GetExtension(item.FilePath).ToUpper()</td>
                        <td style="padding: 14px; color: #cbd5e1;">@(item.BoneStandard ?? "None")</td>
                        <td style="padding: 14px;">
                            @if (item.IsSystem)
                            {
                                <span style="background: #475569; color: #f8fafc; font-size: 0.75rem; padding: 2px 8px; border-radius: 4px;">Hệ thống</span>
                            }
                            else
                            {
                                <span style="background: #0369a1; color: #f8fafc; font-size: 0.75rem; padding: 2px 8px; border-radius: 4px;">Tải lên</span>
                            }
                        </td>
                        <td style="padding: 14px; text-align: right;">
                            @if (!item.IsSystem && item.IsOwnedByUser)
                            {
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display: inline;" onsubmit="return confirm('Bạn có chắc muốn xóa model này không?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" style="background: transparent; border: 1px solid #ef4444; color: #ef4444; padding: 4px 10px; border-radius: 4px; cursor: pointer; font-size: 0.8rem;">Xóa</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>